{
  "name": "inncentives-support",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm -r --filter ./apps/** build",
    "dev": "pnpm --filter @inn/shared build && pnpm -r --parallel --filter ./apps/** dev",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @inn/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @inn/shared build && pnpm -r test",
    "test:coverage": "pnpm --filter @inn/shared build && pnpm -r test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "fastify": "4.28.1"
    }
  }
}
