{
  "name": "@mesa/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "node --env-file-if-exists=../../.env --import tsx src/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@mesa/shared": "workspace:*",
    "bullmq": "5.81.5",
    "nodemailer": "10.1.2",
    "pino": "9.14.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "tsx": "4.23.15",
    "vitest": "3.2.7"
  }
}
