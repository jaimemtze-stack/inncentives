{
  "name": "@mesa/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "9.4.0",
    "@mesa/shared": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "fastify": "5.12.7",
    "imapflow": "2.5.2",
    "ioredis": "5.11.1",
    "libphonenumber-js": "1.13.15",
    "mailparser": "3.9.40",
    "nodemailer": "10.1.2",
    "oci-common": "2.143.0",
    "oci-objectstorage": "2.143.0",
    "otplib": "12.0.1",
    "pino": "9.14.0",
    "prisma": "6.19.3",
    "rate-limiter-flexible": "7.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.18",
    "@types/mailparser": "3.9.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/sanitize-html": "2.16.2",
    "tsx": "4.23.15",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
