# Local development only. Copy to .env (git-ignored). In production every
# SECRET_* value is a file under /run/secrets and env fallbacks are refused.
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
PUBLIC_SCHEME=http
# Open http://soporte.localhost:5173 (customers) and
# http://agentes.soporte.localhost:5173 (staff). Browsers resolve *.localhost.
PORTAL_HOST=soporte.localhost:5173
AGENT_HOST=agentes.soporte.localhost:5173
PWNED_PASSWORDS_CHECK=true

SECRET_DATABASE_URL=postgresql://mesa:mesa_dev_pw@127.0.0.1:55432/mesa
# Same URL for the Prisma CLI (pnpm db:migrate)
DATABASE_URL=postgresql://mesa:mesa_dev_pw@127.0.0.1:55432/mesa
SECRET_REDIS_URL=redis://127.0.0.1:56379/0
# Generate with: echo "k1:$(openssl rand -base64 32)"
SECRET_FIELD_ENCRYPTION_KEYS=

STORAGE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET_ATTACHMENTS=adjuntos
SECRET_S3_ACCESS_KEY_ID=devkey
SECRET_S3_SECRET_ACCESS_KEY=devsecret123

# Worker (Mailpit)
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS=none
MAIL_FROM=Soporte Inncentives <soporte@localhost>

# Demo users created by `pnpm db:seed` (password printed if unset)
SEED_PASSWORD=
