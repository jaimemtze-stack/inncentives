[Unit]
Description=mesa-soporte: fetch secrets from OCI Vault into /run/mesa/secrets
Wants=network-online.target
After=network-online.target run-mesa.mount
OnFailure=mesa-alert@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/opt/mesa/deployer.env
ExecStart=/opt/mesa/scripts/secrets-sync.sh
StandardOutput=append:/var/log/mesa/secrets-sync.log
StandardError=append:/var/log/mesa/secrets-sync.log

[Install]
WantedBy=multi-user.target
