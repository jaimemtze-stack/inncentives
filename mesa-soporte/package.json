{
  "name": "mesa-soporte",
  "private": true,
  "description": "Mesa de soporte de Inncentives (inspirada en Zammad)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "test:int": "pnpm --filter @mesa/api run test:int",
    "test:e2e": "node scripts/e2e.mjs",
    "db:migrate": "pnpm --filter @mesa/api run db:migrate",
    "db:seed": "pnpm --filter @mesa/api run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
