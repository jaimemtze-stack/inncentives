# Copy to .env for local development. NEVER commit real secrets.
# In production, secrets come from Key Vault (SECRETS_PROVIDER=keyvault) or *_FILE mounts.

NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Hosts (portal and agent areas are served on different hosts; cookies are per host)
PORTAL_HOST=localhost
AGENT_HOST=agents.localhost
PORTAL_URL=http://localhost:5173
AGENT_URL=http://agents.localhost:5173

# Local only: browsers refuse Secure/__Host- cookies over plain http
COOKIE_SECURE=false
TRUST_CLOUDFLARE=false

DATABASE_URL=postgresql://inn:change-me-local@localhost:5432/inn_support
REDIS_URL=redis://localhost:6379

# Secrets (generate with: openssl rand -base64 32). Comma-separated for key rotation.
FIELD_ENCRYPTION_KEYS=
CSRF_SECRET=
# SECRETS_PROVIDER=keyvault
# KEYVAULT_URL=https://<vault>.vault.azure.net

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
HIBP_ENABLED=true
RATE_LIMIT_PER_MINUTE=300

# Mail (worker)
MAIL_ADAPTER=smtp
MAIL_FROM="Soporte Inncentives <soporte@localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# GRAPH_MAILBOX=soporte@example.mx

# Demo seed (fictitious data only)
SEED_DEMO_PASSWORD=
